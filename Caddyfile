{
    auto_https disable_redirects
    servers {
        trusted_proxies static private_ranges
    }
}

(app_upstream_pool) {
    header -Server
    request_body {
        max_size 16MB
    }
    encode zstd gzip
    import /etc/caddy/state/upstream.caddy
}

{$SITE_ADDRESS::80} {
    import app_upstream_pool
}

:443 {
    tls internal
    import app_upstream_pool
}
